@model Hotel.Web.Models.Habitacion
@{ ViewData["Title"] = "Editar habitación"; }
<div class="page-heading"><span class="eyebrow">ALOJAMIENTO</span><h1>Editar habitación @Model.Numero</h1><p class="text-muted">Actualiza la configuración de la habitación.</p></div>
<div class="card form-card"><form asp-action="Edit" method="post"><input type="hidden" asp-for="IdHabitacion" /><input type="hidden" asp-for="Activo" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label asp-for="Numero" class="form-label">Número</label><input asp-for="Numero" class="form-control" /><span asp-validation-for="Numero" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Piso" class="form-label">Piso</label><input asp-for="Piso" class="form-control" min="1" /><span asp-validation-for="Piso" class="text-danger"></span></div><div class="col-md-4"><label asp-for="IdTipoHabitacion" class="form-label">Tipo</label><select asp-for="IdTipoHabitacion" class="form-select" asp-items="ViewBag.Tipos"></select><span asp-validation-for="IdTipoHabitacion" class="text-danger"></span></div></div><div class="form-actions"><button class="btn btn-primary">Guardar cambios</button><a asp-action="Index" class="btn btn-link">Cancelar</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
