@model IEnumerable<Hotel.Web.Models.Habitacion>
@{ ViewData["Title"] = "Disponibilidad"; var ingreso = (DateOnly)ViewBag.Ingreso; var salida = (DateOnly)ViewBag.Salida; var noches = salida.DayNumber - ingreso.DayNumber; }
<div class="page-heading"><span class="eyebrow">RESERVAS</span><h1>Disponibilidad</h1><p class="text-muted">Encuentra habitaciones libres para el rango solicitado.</p></div>
<form method="get" class="card filter-card mb-4"><div class="card-body row align-items-end g-3"><div class="col-md-3"><label class="form-label">Ingreso</label><input type="date" name="ingreso" value="@ingreso.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-3"><label class="form-label">Salida</label><input type="date" name="salida" value="@salida.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-auto"><button class="btn btn-primary">Consultar</button></div></div></form>
<div asp-validation-summary="ModelOnly" class="alert alert-warning"></div><div class="d-flex justify-content-between mb-3"><h2 class="h5 mb-0">@noches noche(s) · @ingreso.ToString("dd/MM/yyyy") al @salida.ToString("dd/MM/yyyy")</h2><span class="text-muted">@Model.Count() habitación(es) disponibles</span></div>
<div class="row g-4">@foreach (var item in Model) { var total = item.IdTipoHabitacionNavigation.PrecioNoche * noches; <div class="col-md-6 col-xl-4"><div class="card room-card h-100"><div class="card-body"><div class="d-flex justify-content-between"><h3 class="h5">Habitación @item.Numero</h3><span class="badge-soft">@item.IdTipoHabitacionNavigation.Nombre</span></div><p class="text-muted">Piso @item.Piso · @item.IdTipoHabitacionNavigation.Capacidad personas</p><div class="d-flex justify-content-between align-items-end mt-4"><div><small class="text-muted">Total estimado</small><div class="price">S/ @total.ToString("N2")</div></div><a asp-controller="Reservas" asp-action="Create" asp-route-habitacion="@item.IdHabitacion" class="btn btn-sm btn-primary">Reservar</a></div></div></div></div> }</div>
@if (!Model.Any()) { <div class="card p-5 text-center text-muted">No hay habitaciones disponibles para las fechas seleccionadas.</div> }
