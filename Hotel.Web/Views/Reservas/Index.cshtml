@model IEnumerable<Hotel.Web.Models.Reserva>
@{ ViewData["Title"] = "Reservas"; }
<div class="page-heading d-flex justify-content-between align-items-center"><div><span class="eyebrow">GESTIÓN</span><h1>Reservas</h1><p class="text-muted">Consulta y administra las reservas del hotel.</p></div><a asp-action="Create" class="btn btn-primary">Nueva reserva</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
<div class="card table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Huésped</th><th>Habitación</th><th>Ingreso</th><th>Salida</th><th>Estado</th><th>Total</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { var noches = item.FechaSalida.DayNumber - item.FechaIngreso.DayNumber; var total = item.IdHabitacionNavigation.IdTipoHabitacionNavigation.PrecioNoche * noches; var estadoClase = item.Estado == "Cancelada" ? "status-cancelled" : item.Estado == "Confirmada" ? "status-confirmed" : item.Estado == "Finalizada" ? "status-finished" : "status-pending"; <tr><td><div class="fw-semibold">@item.IdHuespedNavigation.Nombres @item.IdHuespedNavigation.Apellidos</div><small class="text-muted">@item.IdHuespedNavigation.Dni</small></td><td>@item.IdHabitacionNavigation.Numero</td><td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td><td>@item.FechaSalida.ToString("dd/MM/yyyy")</td><td><span class="status @estadoClase">@item.Estado</span></td><td>S/ @total.ToString("N2")</td><td class="text-end">@if (item.Estado is "Pendiente" or "Confirmada") { <form asp-action="Cancelar" method="post" class="d-inline"><input type="hidden" name="id" value="@item.IdReserva" /><button class="btn btn-sm btn-outline-danger">Cancelar</button></form> }</td></tr> }
@if (!Model.Any()) { <tr><td colspan="7" class="text-center py-5 text-muted">Todavía no hay reservas registradas.</td></tr> }
</tbody></table></div></div>
